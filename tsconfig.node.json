{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite.preview.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.pages.config.ts", "playwright.preview.config.ts", "eslint.config.js", "scripts/**/*.ts", "e2e-live/**/*.ts"]
}
